[gd_scene load_steps=4 format=3]

; -gameplay. Il giocatore che `scenes/arena_main.tscn` istanzia.
;
; I suoni sono qui come nodi ma SENZA stream: l'arma e il giocatore si
; caricano `bonk.wav`, `hurt.wav` e `levelup.wav` a runtime, e se un asset non
; c'e' nessun errore e nessun suono. Cosi' nessun test muore perche' la cache
; di import di qualcun altro non e' pronta.

[ext_resource type="Script" path="res://src/player/player.gd" id="1_player"]
[ext_resource type="PackedScene" uid="uid://cldb3k80i0aqb" path="res://assets/models/player.glb" id="2_model"]
[ext_resource type="Script" path="res://src/weapons/weapon_base.gd" id="3_weapon"]

[node name="Player" type="Node3D"]
script = ExtResource("1_player")

[node name="Model" parent="." instance=ExtResource("2_model")]

[node name="Weapon" type="Node3D" parent="."]
script = ExtResource("3_weapon")

[node name="Sfx" type="AudioStreamPlayer3D" parent="Weapon"]

